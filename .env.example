# Neon Postgres connection string (Vercel → Storage → Neon)
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require
# openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_TRUST_HOST=true
# Optional — password reset emails. Without these the reset link is written to
# the server logs instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Chorella <hello@yourdomain.com>
